{
  "name": "threejs-worldgen-monorepo",
  "private": true,
  "description": "Procedural terrain and scenery packages for three.js and react-three-fiber",
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/heightfield",
    "packages/biomes",
    "packages/scatter",
    "packages/trees",
    "packages/water",
    "packages/particles",
    "packages/weathering",
    "packages/fauna",
    "packages/city",
    "packages/props",
    "packages/vehicles",
    "packages/sky",
    "packages/grass",
    "packages/worldgen"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "vite example",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=worldgen-source --test packages/*/test/*.test.ts example/*.test.ts landing/*.test.mjs scripts/*.test.mjs .claude/hooks/*.test.mjs",
    "docs": "typedoc",
    "build:site": "rm -rf site && typedoc --out site/docs && vite build example --base ./ --outDir ../site/demo --emptyOutDir && node landing/build.mjs && node landing/check.mjs",
    "publish:all": "scripts/publish-all.sh",
    "readme:cards": "node landing/readme-cards.mjs",
    "check:options": "node --conditions=worldgen-source scripts/options-coverage.mjs"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "leva": "^0.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
