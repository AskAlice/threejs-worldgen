{
  "name": "threejs-biomes",
  "version": "0.1.0",
  "description": "Seeded climate, 20 blended biomes, mountains, rivers and streaming LOD terrain for three.js",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "worldgen-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "worldgen-source": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./worker": {
      "worldgen-source": "./src/worker.ts",
      "import": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx src/worker.ts --format esm --dts --clean --external three --external react --external @react-three/fiber",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "threejs-heightfield": "^0.1.0"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9",
    "react": ">=19",
    "three": ">=0.186.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AskAlice/threejs-worldgen.git",
    "directory": "packages/biomes"
  },
  "homepage": "https://askalice.github.io/threejs-worldgen/",
  "keywords": [
    "three",
    "threejs",
    "three.js",
    "webgpu",
    "tsl",
    "procedural",
    "react-three-fiber",
    "r3f",
    "biomes"
  ]
}
