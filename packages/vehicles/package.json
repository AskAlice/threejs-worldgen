{
  "name": "threejs-vehicles",
  "version": "0.1.0",
  "description": "Procedural animated vehicles for three.js: cars, bicycles, trains, boats, ships, aircraft and rockets on generated networks",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "worldgen-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "worldgen-source": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx --format esm --dts --clean --external three --external react --external @react-three/fiber",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "threejs-heightfield": "^0.1.0",
    "threejs-biomes": "^0.1.0",
    "threejs-particles": "^0.1.0",
    "threejs-water": "^0.1.0",
    "threejs-weathering": "^0.1.0"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9",
    "react": ">=19",
    "three": ">=0.186.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AskAlice/threejs-worldgen.git",
    "directory": "packages/vehicles"
  },
  "homepage": "https://askalice.github.io/threejs-worldgen/",
  "keywords": [
    "three",
    "threejs",
    "webgpu",
    "tsl",
    "procedural",
    "react-three-fiber",
    "vehicles"
  ]
}
